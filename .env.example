# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://skylark:skylark@localhost:5432/skylark

# Session signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth (optional in dev).
# Without these, the sign-in page falls back to a local developer login.
# Create credentials at https://console.cloud.google.com/apis/credentials
# with redirect URI http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Upstream data collector. Defaults point at Driftnet (../driftnet), which runs
# on Cloudflare Workers — locally via `npm run dev` in that directory.
# In production this is your deployed Worker, e.g.
#   https://driftnet.<subdomain>.workers.dev
PROVIDER_BASE_URL=http://localhost:4000
PROVIDER_API_KEY=mock_provider_key
PROVIDER_TIMEOUT_MS=5000
PROVIDER_MAX_ATTEMPTS=3

# Shared secret for the scheduled reconciliation job. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Billing details shown to customers on the payment methods page.
# Leave blank while testing — the page then says instructions will be emailed
# rather than displaying placeholder bank details.
BILLING_CONTACT_EMAIL=
BILLING_ACCOUNT_NAME=
BILLING_IBAN=
BILLING_BIC=
BILLING_BANK_NAME=

# Public origin printed in the API reference and the OpenAPI document.
# Leave blank in development — it falls back to the request host.
APP_URL=
